GEMINI_API_KEY=your_gemini_api_key

# Mode: imessage or cli
BOT_MODE=imessage

# Required for imessage mode — must match the number you want to chat with
# Accepts Australian local (0432089147) or international (+61432089147)
ALLOWED_CONTACT=+61432089147

# iMessage API server (the separate Node.js API running on the Mac)
# Must match the API_KEY set in that server's .env
IMESSAGE_API_KEY=change-me
# Comma-separated list of URLs to try in order (localhost first, LAN IP fallback)
IMESSAGE_API_URLS=http://localhost:5000,http://192.168.0.49:5000

# How often (ms) to poll the iMessage API for new messages
POLL_INTERVAL_MS=3000

# Optional contact key used for memory in cli mode
CLI_CONTACT=terminal-user

GEMINI_MODEL=gemini-2.5-flash-lite
MEMORY_DB_PATH=./data/memories.sqlite
SEND_EMOJI_REACTION=true
MAX_ATTACHMENT_BYTES=20971520
DEBUG=false
