# --- Gemini ---
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# --- imessage-api-catalina ---
# Atlas talks to a separate local-network REST + SSE process running on the
# same Mac that owns the Messages.app account.
# Bearer auth — must match the server's API_KEY.
IMESSAGE_API_URL=http://localhost:8787
IMESSAGE_API_KEY=replace-me-with-server-api-key

# --- Mode ---
# imessage = listen on the SSE event stream and reply via /send
# cli      = local terminal chat (great for prompt iteration)
BOT_MODE=imessage

# --- Allowed contact ---
# E.164 phone or Apple ID email. Atlas will only reply to messages from this
# handle. Must also be in the API server's ALLOWED_RECIPIENTS list,
# otherwise outbound sends will be rejected by the server's safety layer.
ALLOWED_CONTACT=

# --- Optional ---
# Sent once on startup so you know the bot is alive (leave blank to skip)
STARTUP_MESSAGE=

# Memory key used in cli mode (any string)
CLI_CONTACT=terminal-user

# Local SQLite memory store
MEMORY_DB_PATH=./data/memories.sqlite

# Soft cap per outbound iMessage — long replies are split on whitespace
MAX_IMESSAGE_CHUNK=1000

# Skip Gemini file uploads larger than this many bytes
MAX_ATTACHMENT_BYTES=20971520

# Verbose logging
DEBUG=false
