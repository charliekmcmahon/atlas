{
  "name": "atlas",
  "version": "1.0.0",
  "description": "iMessage chatbot powered by Gemini, fronted by the imessage-api-catalina local API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "imessage": "tsx src/index.ts --mode=imessage",
    "cli": "tsx src/index.ts --mode=cli",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "imessage",
    "gemini",
    "chatbot"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^11.5.0",
    "cron-parser": "^4.10.0",
    "dotenv": "^16.4.5",
    "mime": "^4.1.0",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
